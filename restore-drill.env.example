# Copy to /etc/restore-drill/<stack>.env and edit. One file per stack you drill.
#
# DRILL_IMAGE must be the SAME image the live database runs. That is not a
# detail: a dump can only be loaded by a server at least as new as the client
# that wrote it, and a backup sidecar pinned one major ahead of its own
# database writes statements the database cannot parse. Matching the image
# here turns that into a failed drill instead of a failed recovery.

DRILL_ENGINE=postgres                 # postgres | mysql  (mysql covers MariaDB)
DRILL_IMAGE=postgres:16
DRILL_BACKUPS_PATH=/var/lib/docker/volumes/app_database-backups/_data
DRILL_DB_NAME=appdb
DRILL_DB_USER=appuser
DRILL_DB_PASSWORD=

# Which files in that directory are dumps. Anything ending .partial or .failed
# is skipped whatever this says.
DRILL_PATTERN=*.gz

# THE LIVE DATABASE, AS THE REFERENCE. Name the running container and the
# drill asks it which tables it has, then requires every one of them back from
# the restored dump and says which did not come. It uses DRILL_DB_USER and
# DRILL_DB_PASSWORD to ask, so those have to work against the live database
# too. A live database it cannot read fails the drill: a comparison that did
# not happen is not a clean result.
# DRILL_LIVE_CONTAINER=nextcloud-postgres

# The fallback when the line above is not set, and the weaker check of the two.
# Fewer tables than this and the drill fails. A dump that loads without error
# and produces nothing is the failure mode a checksum can never see, and the
# default of 1 only catches a completely empty one.
#
# It is a number somebody writes once: it passes for a dump that restored a
# fifth of the schema, and it keeps passing as the application grows away from
# it. Prefer DRILL_LIVE_CONTAINER, which cannot go stale because it asks.
DRILL_MIN_TABLES=1

# Seconds to wait for the throwaway database to answer an authenticated query.
DRILL_TIMEOUT=300

DRILL_STATE_DIR=/var/lib/restore-drill
